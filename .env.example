# ------------------------------------------------------------------
# Riz Vedha — copy this file to `.env.local` and fill in the two values.
# Until they exist the app runs 100% local: no account chip, no network.
# ------------------------------------------------------------------

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → publishable key (or the older anon key).
# Vite only exposes variables that start with VITE_, not NEXT_PUBLIC_*.
VITE_SUPABASE_ANON_KEY=
# Alternative name, also accepted:
# VITE_SUPABASE_PUBLISHABLE_KEY=
