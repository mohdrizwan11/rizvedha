{"id": "modern-09", "module": "modern", "num": 9, "title": "Governor-General and Viceroy", "pages": [185, 186], "sections": [{"title": "Governor-generals of India", "blocks": [{"type": "fact", "text": "Lord Warren Hastings (1773-1785)"}, {"type": "fact", "text": "Regulating Act (1773) > 1st Governor General of Bengal."}, {"type": "fact", "text": "Pitt's India Act (1784)."}, {"type": "fact", "text": "1st Anglo-Maratha War (1775-1782) > Treaty of Salbai signed (1782)"}, {"type": "fact", "text": "2nd Anglo-Mysore War (1780-1784)."}, {"type": "fact", "text": "Asiatic Society of Bengal (1784) formed."}, {"type": "fact", "text": "Lord Cornwallis (1786-1793)"}, {"type": "fact", "text": "3rd Anglo-Mysore War (1790-1792) — Treaty of Seringpatnam."}, {"type": "fact", "text": "Permanent Settlement (1793)"}, {"type": "fact", "text": "Death: India (tomb in Ghazipur, Uttar Pradesh)."}, {"type": "fact", "text": "He is known as Father of Indian Civil Services."}, {"type": "fact", "text": "Lord Wellesley (1798-1805)"}, {"type": "fact", "text": "2nd Anglo-Maratha War (1803-1805)."}, {"type": "fact", "text": "4th Anglo-Mysore War (1799)."}, {"type": "fact", "text": "Treaty of Bassein (1802)."}, {"type": "fact", "text": "Treaty of Amritsar (1809) signed between Maharaja Ranjit Singh and Britishers."}, {"type": "fact", "text": "Lord Hastings (1813-1823)"}, {"type": "fact", "text": "3rd Anglo-Maratha War (1817-1819)."}, {"type": "fact", "text": "Anglo-Nepal War (1814-1816) — Treaty of Sagauli signed."}, {"type": "fact", "text": "Ryotwari System introduced by Munro and Reed."}, {"type": "fact", "text": "Lord William Bentinck (1828-1835)"}, {"type": "fact", "text": "First Governor-General of India."}, {"type": "fact", "text": "Abolition of Sati (1829)."}, {"type": "fact", "text": "He abolished Circuit Courts."}, {"type": "fact", "text": "He is known as Father of Modern Education in India > Macaulay's Minute (1835) during his tenure."}, {"type": "fact", "text": "Lord Metcalfe (1835-1836)"}, {"type": "fact", "text": "He is known as the Liberator of Indian Press."}, {"type": "fact", "text": "Lord Auckland (1836-1842)"}, {"type": "fact", "text": "1st Anglo-Afghan War (1838-1842)."}, {"type": "fact", "text": "Lord Hardinge (1844-1848)"}, {"type": "fact", "text": "1st Anglo-Sikh War — Treaty of Lahore signed."}, {"type": "fact", "text": "Lord Dalhousie (1848-1856)"}, {"type": "fact", "text": "Doctrine of Lapse (1848)."}, {"type": "fact", "text": "1st railway line laid down (1853) — from Bombay to Thane (34 km)."}, {"type": "fact", "text": "Widow Remarriage Act (1856)."}, {"type": "fact", "text": "Postal Act Telegraph lines spread across."}, {"type": "fact", "text": "Wood's Dispatch (1854) + Magna Carta of Indian Education."}, {"type": "fact", "text": "He founded Public Works Department (PWD)."}, {"type": "fact", "text": "2nd Anglo-Sikh War (1848-1849)."}]}, {"title": "Viceroys", "blocks": [{"type": "fact", "text": "Lord Canning (1856-1862)"}, {"type": "fact", "text": "He became the 1st Viceroy of India."}, {"type": "fact", "text": "1857 Revolt.,"}, {"type": "fact", "text": "Government of India Act (1858) was passed."}, {"type": "fact", "text": "1st Unsynchronised (not complete) Census was held during his tenure (1872)."}, {"type": "fact", "text": "He established Statistical Survey of India."}, {"type": "fact", "text": "Sher Ali Afridi killed him in Andaman Jail."}, {"type": "fact", "text": "He brought Vernacular Press Act (1878) to ban local newspapers."}, {"type": "fact", "text": "First Delhi Durbar (1877) to proclaim Queen Victoria as Empress of India."}, {"type": "fact", "text": "He lowered the maximum age of eligibility for Civil Services (reduced the age from 21 to 19 years)."}, {"type": "fact", "text": "\"Bengal Gazette\" by James Augustus Hickey was the 1st Newspaper in India (1780)."}, {"type": "fact", "text": "Ilbert bill was introduced in 1883."}, {"type": "fact", "text": "He repealed Vernacular Press Act."}, {"type": "fact", "text": "1st Synchronised (complete) Census held during his tenure"}, {"type": "fact", "text": "He is known as Father of Local Self-Government."}, {"type": "fact", "text": "Hunter Commission (1882) was setup which was related to Education."}, {"type": "fact", "text": "st Factory Act (1881)."}, {"type": "fact", "text": "Lord Dufferin (1884-1888)"}, {"type": "fact", "text": "Formation of INC (1885)."}, {"type": "fact", "text": "Partition of Bengal (1905)."}, {"type": "fact", "text": "Curzon-Kitchner controversy."}, {"type": "fact", "text": "Younghusband Mission (to Tibet)."}, {"type": "fact", "text": "Muslim League formation (1906) by Aga Khan."}, {"type": "fact", "text": "Lord Hardinge II (1910-1916)"}, {"type": "fact", "text": "3rd Delhi Durbar for King George (1911)."}, {"type": "fact", "text": "During his tenure, capital shifted from Calcutta to Delhi."}, {"type": "fact", "text": "Royal Commission on Civil Services was appointed in Lord Chelmsford (1916-1921)"}, {"type": "fact", "text": "Government of India Act, also known as Montagu- Chelmsford Reforms (1919)."}, {"type": "fact", "text": "Rowlatt Act (1919)."}, {"type": "fact", "text": "Jallianwala Bagh Massacre (1919)."}, {"type": "fact", "text": "Lord Reading (1921-1926)"}, {"type": "fact", "text": "Chauri Chaura Incident (1922)."}, {"type": "fact", "text": "Kakori Train Incident (1925)."}, {"type": "fact", "text": "Establishment of Swaraj Party (1923)."}, {"type": "fact", "text": "Repeal of Press Act (1910) and Rowlatt Act (1919)."}, {"type": "fact", "text": "Visit of Simon Commission (1928)."}, {"type": "fact", "text": "Lahore Session of Congress (1929)."}, {"type": "fact", "text": "Dandi March (1930)."}, {"type": "fact", "text": "1st Round Table Conference."}, {"type": "fact", "text": "Lord Willingdon (1931-1936)"}, {"type": "fact", "text": "2nd Round Table Conference."}, {"type": "fact", "text": "3rd Round Table Conference."}, {"type": "fact", "text": "Government of India Act (1935)."}, {"type": "fact", "text": "Lord Linlithgow (1936-1944)"}, {"type": "fact", "text": "August Offer (1940)."}, {"type": "fact", "text": "Individual Satyagrah (1940)."}, {"type": "fact", "text": "Quit India Movement (1942)."}, {"type": "fact", "text": "Cripps Mission (1942)."}, {"type": "fact", "text": "CR Formula (1944)."}, {"type": "fact", "text": "Wavell Plan (1945)."}, {"type": "fact", "text": "Cabinet Mission Proposals (1946)."}, {"type": "fact", "text": "Observance of Direct Action Day (16 August 1946)."}, {"type": "fact", "text": "Lord Mountbatten (1947-48)"}, {"type": "fact", "text": "Last British Governor General of India."}, {"type": "fact", "text": "Only Indian Governor General of India: C. Rajagopalachari."}]}], "factCount": 94}